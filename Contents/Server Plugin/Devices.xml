<?xml version="1.0"?>
<Devices>
    <Device type="custom" id="espCore">
        <Name>ESPHome Board</Name>
        <ConfigUI>
            <Field id="title" type="label" fontSize="large" fontColor="blue">
                <Label>ESPHome Board</Label>
            </Field>
            <Field id="sep1" type="separator"/>
            <Field id="address" type="textfield" defaultValue="">
                <Label>Address:</Label>
            </Field>
            <Field id="addressHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>IP address or mDNS name, e.g. 192.168.1.60 or kitchen-sensor.local. A DHCP reservation is recommended.</Label>
            </Field>
            <Field id="port" type="textfield" defaultValue="6053">
                <Label>API port:</Label>
            </Field>
            <Field id="encryptionKey" type="textfield" defaultValue="" secure="true">
                <Label>API encryption key:</Label>
            </Field>
            <Field id="keyHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>The api: encryption: key: value from the board's YAML. Leave blank if the board has no encryption.</Label>
            </Field>
            <Field id="password" type="textfield" defaultValue="" secure="true">
                <Label>API password (legacy):</Label>
            </Field>
            <Field id="sep2" type="separator"/>
            <Field id="forwardLogs" type="menu" defaultValue="off">
                <Label>Show board logs in Indigo:</Label>
                <List>
                    <Option value="off">Off</Option>
                    <Option value="error">Errors only</Option>
                    <Option value="warn">Warnings and errors</Option>
                    <Option value="info">Info</Option>
                    <Option value="debug">Debug (very chatty)</Option>
                </List>
            </Field>
            <Field id="dashboardConfiguration" type="textfield" defaultValue="">
                <Label>Device Builder config file:</Label>
            </Field>
            <Field id="dbHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>Optional, e.g. kitchen-sensor.yaml. Leave blank to match automatically by node name.</Label>
            </Field>
            <Field id="sepHealth" type="separator"/>
            <Field id="graceSeconds" type="textfield" defaultValue="30">
                <Label>Offline grace period (s):</Label>
            </Field>
            <Field id="graceHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>Brief Wi-Fi drops shorter than this are logged but don't mark the board or its devices offline. 0 = report immediately.</Label>
            </Field>
            <Field id="sepLink" type="separator"/>
            <Field id="shareStates" type="checkbox" defaultValue="false">
                <Label>Indigo link:</Label>
                <Description>Share Indigo device states and variables with this board</Description>
            </Field>
            <Field id="allowControl" type="checkbox" defaultValue="false">
                <Label></Label>
                <Description>Allow this board to control Indigo (run action groups, switch devices, set variables)</Description>
            </Field>
            <Field id="linkHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>Uses ESPHome's homeassistant platforms - see the module library on the setup page for examples. The YAML also needs api: homeassistant_states / homeassistant_services: true.</Label>
            </Field>
            <Field id="bleRoom" type="textfield" defaultValue="">
                <Label>Room (Bluetooth presence):</Label>
            </Field>
            <Field id="bleHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>Used when this board runs bluetooth_proxy. Blank = the board's name.</Label>
            </Field>
            <Field id="sep3" type="separator"/>
            <Field id="syncNow" type="button">
                <Label>Entities:</Label>
                <Title>Sync Entities Now</Title>
                <CallbackMethod>config_sync_now</CallbackMethod>
            </Field>
            <Field id="syncHelp" type="label" fontSize="small" alignWithControl="true">
                <Label>Creates Indigo devices for any entities that don't have one yet. Renaming the Indigo devices is safe.</Label>
            </Field>
        </ConfigUI>
