    <Device type="sensor" id="espBleTracker">
        <Name>Bluetooth Tracker (ESPHome room presence)</Name>
        <ConfigUI>
            <Field id="SupportsOnState" type="checkbox" defaultValue="true" hidden="true"/>
            <Field id="SupportsSensorValue" type="checkbox" defaultValue="false" hidden="true"/>
            <Field id="SupportsStatusRequest" type="checkbox" defaultValue="false" hidden="true"/>
            <Field id="idType" type="menu" defaultValue="mac">
                <Label>Identify by:</Label>
                <List>
                    <Option value="mac">Fixed MAC address (tags, beacons)</Option>
                    <Option value="irk">IRK (iPhone, Apple Watch, modern phones)</Option>
                    <Option value="ibeacon">iBeacon UUID</Option>
                </List>
            </Field>
            <Field id="identifier" type="textfield">
                <Label>MAC / IRK / UUID:</Label>
            </Field>
            <Field id="major" type="textfield" visibleBindingId="idType" visibleBindingValue="ibeacon">
                <Label>Major (optional):</Label>
            </Field>
            <Field id="minor" type="textfield" visibleBindingId="idType" visibleBindingValue="ibeacon">
                <Label>Minor (optional):</Label>
            </Field>
            <Field id="awayTimeout" type="textfield" defaultValue="180">
                <Label>Away after (s):</Label>
            </Field>
            <Field id="switchMargin" type="textfield" defaultValue="5">
                <Label>Room switch margin (dB):</Label>
            </Field>
            <Field id="help" type="label" fontSize="small">
                <Label>Needs at least one ESPHome board running bluetooth_proxy (see the module library). Each board's room is set in its own settings. A larger margin means fewer room changes when you're between two rooms.</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="room">
                <ValueType>String</ValueType>
                <TriggerLabel>Room</TriggerLabel>
                <ControlPageLabel>Room</ControlPageLabel>
            </State>
            <State id="previousRoom">
                <ValueType>String</ValueType>
                <TriggerLabel>Previous Room</TriggerLabel>
                <ControlPageLabel>Previous Room</ControlPageLabel>
            </State>
            <State id="rssi">
                <ValueType>Number</ValueType>
                <TriggerLabel>Signal (dBm)</TriggerLabel>
                <ControlPageLabel>Signal (dBm)</ControlPageLabel>
            </State>
            <State id="heardBy">
                <ValueType>String</ValueType>
                <TriggerLabel>Heard By</TriggerLabel>
                <ControlPageLabel>Heard By</ControlPageLabel>
            </State>
            <State id="lastSeen">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Seen</TriggerLabel>
                <ControlPageLabel>Last Seen</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>room</UiDisplayStateId>
    </Device>

